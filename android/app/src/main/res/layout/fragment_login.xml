<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- ЛОГОТИП (Старый ID: logoContainer) -->
        <FrameLayout
            android:id="@+id/logoContainer"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:background="@drawable/bg_circle_teal"
            android:elevation="3dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_logo"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_app_logo" />
        </FrameLayout>

        <!-- ЗАГОЛОВОК (Старый ID: tvTitle) -->
        <TextView
            android:id="@+id/tvTitle"
            style="@style/TextAppearance.App.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/login_title"
            android:textColor="@color/text_header"
            android:textSize="30sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/logoContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ВЫБОР РОЛИ (Старые ID: tabsContainer, tabDoctor, tabPatient) -->
        <LinearLayout
            android:id="@+id/tabsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_segment_container"
            android:elevation="2dp"
            android:orientation="horizontal"
            android:layout_marginBottom="2dp"
            android:padding="2dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tabDoctor"
                style="@style/TextAppearance.MedicalApp.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_segment_selected"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/role_doctor"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabPatient"
                android:layout_width="0dp"
                style="@style/TextAppearance.MedicalApp.Body"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/role_patient"
                android:textColor="@color/text_secondary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- КОНТЕЙНЕР ПОЛЕЙ ВВОДА (Старый ID: inputsContainer сохранен для безопасности кода) -->
        <LinearLayout
            android:id="@+id/inputsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/tabsContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Поле Email -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_field"
                android:elevation="2dp"
                android:layout_marginBottom="2dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:id="@+id/ivEmail"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/cd_email"
                    android:src="@drawable/ic_mail"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Старый ID: etEmail -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEmail"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false"

                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"

                    app:layout_constraintStart_toEndOf="@+id/ivEmail"
                    app:layout_constraintTop_toTopOf="parent">


                    <EditText
                        android:id="@+id/etEmail"

                        style="@style/TextAppearance.MedicalApp.Body"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:hint="@string/hint_email"
                        android:inputType="textEmailAddress"
                        android:padding="0dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="20sp" />

                </com.google.android.material.textfield.TextInputLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Поле Password -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_input_field"
                android:elevation="2dp"
                android:layout_marginBottom="2dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:id="@+id/ivPassword"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/cd_password"
                    android:src="@drawable/ic_lock"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Старый ID: etPassword -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    app:boxBackgroundMode="none"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/icon_gray"
                    app:hintEnabled="false"

                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"

                    app:layout_constraintStart_toEndOf="@+id/ivPassword"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        style="@style/TextAppearance.MedicalApp.Body"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:hint="@string/hint_password"
                        android:inputType="textPassword"
                        android:padding="0dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="20sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Старый ID: btnTogglePassword -->
            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

        <!-- ТЕКСТ ОШИБКИ (Из оригинальной разметки, в Фигме его не было) -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="0dp"
            style="@style/TextAppearance.MedicalApp.Description"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/design_default_color_error"
            tools:text="Incorrect login/password. Try again"
            app:layout_constraintTop_toBottomOf="@+id/inputsContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- КНОПКА ВОЙТИ (Старый ID: btnLogin) -->
        <!-- Оставлен MaterialButton, чтобы не сломать каст в Java/Kotlin, но стилизован под Фигму -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"

            android:enabled="true"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/primary_teal"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/action_login"
            android:textColor="@color/white"
            android:textStyle="bold"
            style="@style/TextAppearance.MedicalApp.Body"
            android:textSize="20sp"
            app:layout_constraintTop_toBottomOf="@id/tvError"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ПРОГРЕСС БАР (Из оригинальной разметки) -->
        <ProgressBar
            android:id="@+id/authProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/btnLogin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- НЕТ АККАУНТА / ПОМОЩЬ (Старый ID: tvRegister, Дизайн: tvHelp из Фигмы) -->
        <TextView
            android:id="@+id/tvRegister"
            style="@style/TextAppearance.MedicalApp.Description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/register_text"
            android:textColor="@color/text_hint"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@+id/authProgressBar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_bias="1.0" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>