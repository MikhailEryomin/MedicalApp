<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg">

    <!-- Header (Старый ID: headerAddPatient) -->
    <LinearLayout
        android:id="@+id/headerAddPatient"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:elevation="2dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="60dp">

            <FrameLayout
                android:id="@+id/btnBackAddPatient"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_circle_light"
                android:elevation="2dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageButton
                    android:layout_width="match_parent"
                    android:background="@android:color/transparent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:contentDescription="Назад"
                    android:src="@drawable/ic_back" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Регистрация"
                android:textColor="@color/text_primary"
                style="@style/TextAppearance.MedicalApp.Header"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="80dp"
        app:layout_constraintTop_toBottomOf="@id/headerAddPatient"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/formCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_form_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">


                <!-- First Name -->
                <TextView
                    android:layout_marginTop="14dp"
                    android:text="Имя *"
                    style="@style/TextAppearance.MedicalApp.Description"
                    android:textColor="#5E6470"
                    android:textStyle="bold" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field"
                    android:elevation="2dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">
                    <ImageView
                        android:id="@+id/ivFirstName"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_user"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                    <EditText
                        android:id="@+id/etFirstName"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="16dp"
                        android:background="@android:color/transparent"
                        android:hint="Введите имя"
                        android:padding="0dp"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        app:layout_constraintStart_toEndOf="@id/ivFirstName"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Last Name -->
                <TextView
                    android:layout_marginTop="12dp"
                    android:text="Фамилия *"
                    style="@style/TextAppearance.MedicalApp.Description"
                    android:textColor="#5E6470"
                    android:textStyle="bold" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field"
                    android:elevation="2dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">
                    <ImageView
                        android:id="@+id/ivLastName"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_user"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                    <EditText
                        android:id="@+id/etLastName"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="16dp"
                        android:background="@android:color/transparent"
                        android:hint="Введите фамилию"
                        android:padding="0dp"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        app:layout_constraintStart_toEndOf="@id/ivLastName"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Date of Birth (Старый ID: etDob) -->
                <TextView
                    style="@style/TextAppearance.MedicalApp.Description"
                    android:layout_marginTop="12dp"
                    android:text="Дата рождения *"
                    android:textColor="#5E6470"
                    android:textStyle="bold" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field"
                    android:elevation="2dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">
                    <ImageView
                        android:id="@+id/ivBirthDate"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_calendar"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                    <EditText
                        android:id="@+id/etDob"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="16dp"
                        android:background="@android:color/transparent"
                        android:hint="ДД.ММ.ГГГГ"
                        android:padding="0dp"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        app:layout_constraintStart_toEndOf="@id/ivBirthDate"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Gender (Старые ID: btnMale, btnFemale) -->
                <TextView
                    style="@style/TextAppearance.MedicalApp.Description"
                    android:layout_marginTop="12dp"
                    android:text="Пол *"
                    android:textColor="#5E6470"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layoutGender"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_gender_container"
                    android:elevation="2dp"
                    android:orientation="horizontal"
                    android:padding="2dp">
                    <TextView
                        android:id="@+id/btnMale"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_gender_selected"
                        android:gravity="center"
                        android:text="Мужской"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/btnFemale"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Женский"
                        android:textColor="@color/text_secondary"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Email (Старый ID: etPatientEmail) -->
                <TextView
                    style="@style/TextAppearance.MedicalApp.Description"
                    android:layout_marginTop="12dp"
                    android:text="Email *"
                    android:textColor="#5E6470"
                    android:textStyle="bold" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field"
                    android:elevation="2dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">
                    <ImageView
                        android:id="@+id/ivEmail"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_mail"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                    <EditText
                        android:id="@+id/etPatientEmail"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="16dp"
                        android:background="@android:color/transparent"
                        android:hint="Почта"
                        android:inputType="textEmailAddress"
                        android:padding="0dp"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        app:layout_constraintStart_toEndOf="@id/ivEmail"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />


                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/email_helper"
                    android:textColor="#CC7D8390"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Password (Старый ID: etPatientPassword) -->
                <TextView
                    style="@style/TextAppearance.MedicalApp.Description"
                    android:layout_marginTop="12dp"
                    android:text="Пароль *"
                    android:textColor="#5E6470"
                    android:textStyle="bold" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field"
                    android:elevation="2dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">
                    <ImageView
                        android:id="@+id/ivPassword"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_lock"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                    <EditText
                        android:id="@+id/etPatientPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="16dp"
                        android:background="@android:color/transparent"
                        android:hint="Пароль"
                        android:inputType="textPassword"
                        android:padding="0dp"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        app:layout_constraintStart_toEndOf="@id/ivPassword"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/email_helper"
                    android:textColor="#CC7D8390"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Allergies (Старый ID: etAllergy) -->
                <TextView
                    android:layout_marginTop="12dp"
                    android:text="Аллергия"
                    android:textColor="#5E6470"
                    style="@style/TextAppearance.MedicalApp.Description"
                    android:textStyle="bold" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field"
                    android:elevation="2dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="12dp">
                    <ImageView
                        android:id="@+id/ivAllergies"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_tag"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                    <EditText
                        android:id="@+id/etAllergy"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="12dp"
                        android:background="@android:color/transparent"
                        android:hint="Например: пеницилин"
                        android:padding="0dp"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        app:layout_constraintStart_toEndOf="@id/ivAllergies"
                        app:layout_constraintEnd_toStartOf="@id/btnAddAllergy"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                    <FrameLayout
                        android:id="@+id/btnAddAllergy"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_add_circle_light"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_plus"
                            app:tint="@color/text_primary" />
                    </FrameLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>


                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupAllergies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"/>

                <!-- Chronic Diseases (Старый ID: etDisease) -->
                <TextView
                    style="@style/MedicalApp"
                    android:layout_marginTop="12dp"
                    android:text="Хронические заболевания"
                    android:textColor="#5E6470"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field"
                    android:elevation="2dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="12dp">
                    <ImageView
                        android:id="@+id/ivDiseases"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_tag"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                    <EditText
                        android:id="@+id/etDisease"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="12dp"
                        android:background="@android:color/transparent"
                        android:hint="Например: диабет"
                        android:padding="0dp"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        app:layout_constraintStart_toEndOf="@id/ivDiseases"
                        app:layout_constraintEnd_toStartOf="@id/btnAddDisease"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                    <FrameLayout
                        android:id="@+id/btnAddDisease"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_add_circle_light"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_plus"
                            app:tint="@color/text_primary" />
                    </FrameLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupDiseases"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Bar (Старый ID: btnCreatePatient) -->
    <LinearLayout
        android:visibility="visible"
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="20dp"
        android:elevation="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreatePatient"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Зарегистрироваться"
                android:textAllCaps="false"
                android:textSize="20sp"
                app:cornerRadius="16dp"/>

            <ProgressBar
                android:id="@+id/progressBarCreatePatient"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"/>
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>