<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_gray">

    <!-- Header (Белая шапка) -->
    <LinearLayout
        android:id="@+id/headerAddPatient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="16dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackAddPatient"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_gray"
            android:src="@drawable/ic_arrow_left" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Регистрация"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Скроллящаяся форма -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintTop_toBottomOf="@id/headerAddPatient">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- БЕЛАЯ КАРТОЧКА ФОРМЫ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:contentPadding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:text="Patient Information"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Full Name -->
                    <TextView
                        style="@style/MedicalApp"
                        android:text="First Name *" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_rounded_border"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">
                        <ImageView
                            android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_user" app:tint="@color/icon_gray"/>
                        <EditText
                            android:id="@+id/etFirstName"
                            android:layout_width="match_parent" android:layout_height="match_parent"
                            android:background="@null" android:hint="Enter first name"
                            android:paddingStart="12dp" android:textColor="@color/text_primary"/>
                    </LinearLayout>

                    <TextView
                        style="@style/MedicalApp"
                        android:text="Last Name *" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_rounded_border"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">
                        <ImageView
                            android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_user" app:tint="@color/icon_gray"/>
                        <EditText
                            android:id="@+id/etLastName"
                            android:layout_width="match_parent" android:layout_height="match_parent"
                            android:background="@null" android:hint="Enter last name"
                            android:paddingStart="12dp" android:textColor="@color/text_primary"/>
                    </LinearLayout>

                    <!-- Date of Birth -->
                    <TextView
                        android:text="Date of Birth *"
                        style="@style/MedicalApp"
                        android:layout_marginTop="16dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_rounded_border"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">
                        <ImageView
                            android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_calendar" app:tint="@color/icon_gray"/>
                        <EditText
                            android:id="@+id/etDob"
                            android:layout_width="match_parent" android:layout_height="match_parent"
                            android:background="@null" android:hint="DD.MM.YYYY"
                            android:paddingStart="12dp" android:textColor="@color/text_primary"/>
                    </LinearLayout>

                    <!-- Gender Select -->
                    <TextView
                        android:text="Gender *"
                        style="@style/MedicalApp"
                        android:layout_marginTop="16dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <!-- Кнопка Male -->
                        <TextView
                            android:id="@+id/btnMale"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_gender_active"
                            android:gravity="center"
                            android:text="Male"
                            android:textColor="@color/primary_teal"
                            android:textStyle="bold"/>

                        <!-- Кнопка Female -->
                        <TextView
                            android:id="@+id/btnFemale"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_gender_inactive"
                            android:gravity="center"
                            android:text="Female"
                            android:textColor="@color/text_secondary"
                            android:textStyle="bold"/>
                    </LinearLayout>


                    <!-- Email -->
                    <TextView
                        android:text="Email *"
                        style="@style/MedicalApp"
                        android:layout_marginTop="16dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_rounded_border"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">
                        <ImageView
                            android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_email" app:tint="@color/icon_gray"/>
                        <EditText
                            android:id="@+id/etPatientEmail"
                            android:layout_width="match_parent" android:layout_height="match_parent"
                            android:background="@null" android:hint="patient@email.com"
                            android:inputType="textEmailAddress"
                            android:paddingStart="12dp" android:textColor="@color/text_primary"/>
                    </LinearLayout>


                    <!-- Email -->
                    <TextView
                        android:text="Password *"
                        style="@style/MedicalApp"
                        android:layout_marginTop="12dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_rounded_border"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">
                        <ImageView
                            android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/bg_schedule_taken" app:tint="@color/icon_gray"/>
                        <EditText
                            android:id="@+id/etPatientPassword"
                            android:layout_width="match_parent" android:layout_height="match_parent"
                            android:background="@null" android:hint="Enter password here"
                            android:inputType="textPassword"
                            android:paddingStart="12dp" android:textColor="@color/text_primary"/>
                    </LinearLayout>


                    <!-- Секция: Медицинская информация -->
                    <!-- Allergies -->
                    <TextView
                        style="@style/MedicalApp"
                        android:layout_marginTop="16dp"
                        android:text="Allergies" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_rounded_border"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_info"
                                app:tint="@color/icon_gray"/>

                            <EditText
                                android:id="@+id/etAllergy"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@null"
                                android:hint="e.g. Penicillin"
                                android:paddingStart="12dp"
                                android:textColor="@color/text_primary"
                                android:imeOptions="actionDone"
                                android:inputType="text"/>
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/btnAddAllergy"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_button_teal_rounded"
                            android:src="@drawable/baseline_add_24"
                            app:tint="@color/white"
                            android:contentDescription="Add allergy"/>
                    </LinearLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupAllergies"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"/>

                    <!-- Chronic Diseases -->
                    <TextView
                        style="@style/MedicalApp"
                        android:text="Chronic Diseases"
                        android:layout_marginTop="16dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_rounded_border"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_info"
                                app:tint="@color/icon_gray"/>

                            <EditText
                                android:id="@+id/etDisease"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@null"
                                android:hint="e.g. Diabetes"
                                android:paddingStart="12dp"
                                android:textColor="@color/text_primary"
                                android:imeOptions="actionDone"
                                android:inputType="text"/>
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/btnAddDisease"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_button_teal_rounded"
                            android:src="@drawable/baseline_add_24"
                            app:tint="@color/white"
                            android:contentDescription="Add disease"/>
                    </LinearLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupDiseases"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Пустое пространство чтобы контент не скрылся за кнопкой -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="20dp" />

        </LinearLayout>
    </ScrollView>

    <!-- НИЖНЯЯ ПАНЕЛЬ С КНОПКОЙ -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="24dp"
        android:elevation="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreatePatient"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Зарегистрироваться"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/primary_teal"/>

            <ProgressBar
                android:id="@+id/progressBarCreatePatient"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_gravity="center"
                android:layout_height="wrap_content"/>


        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>