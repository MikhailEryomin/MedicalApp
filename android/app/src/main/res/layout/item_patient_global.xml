<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardPatient"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_patient_card"
    android:elevation="2dp"
    android:paddingHorizontal="10dp"
    android:paddingBottom="15dp"
    android:paddingTop="15dp">

    <TextView
        android:id="@+id/tvInitials"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_avatar_teal"
        android:gravity="center"
        android:text="ИИ"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        style="@style/TextAppearance.MedicalApp.Description"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/layoutInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/tvInitials"
        app:layout_constraintEnd_toStartOf="@+id/btnAttach"
        app:layout_constraintStart_toEndOf="@id/tvInitials"
        app:layout_constraintTop_toTopOf="@id/tvInitials">

        <TextView
            android:id="@+id/tvPatientName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Иванов И.И."
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            style="@style/TextAppearance.MedicalApp.Body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPatientAge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="45 years"
            android:textColor="@color/text_hint"
            android:textSize="16dp"
            style="@style/TextAppearance.MedicalApp.Description"
            android:textStyle="bold" />

    </LinearLayout>


    <ImageButton
        android:id="@+id/btnAttach"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_vertical"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@drawable/ic_plus"
        app:tint="@color/icon_gray"
        android:contentDescription="Add patient" />


</androidx.constraintlayout.widget.ConstraintLayout>