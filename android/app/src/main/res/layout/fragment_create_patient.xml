<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_gray">

    <!-- Header (Белая шапка) -->
    <LinearLayout
        android:id="@+id/headerAddPatient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="16dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackAddPatient"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_gray"
            android:src="@drawable/ic_arrow_left" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="New Patient"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Скроллящаяся форма -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintTop_toBottomOf="@id/headerAddPatient">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- БЕЛАЯ КАРТОЧКА ФОРМЫ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:contentPadding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:text="Patient Information"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Full Name -->
                    <TextView
                        style="@style/MedicalApp"
                        android:text="Full Name *" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_rounded_border"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">
                        <ImageView
                            android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_user" app:tint="@color/icon_gray"/>
                        <EditText
                            android:id="@+id/etFullName"
                            android:layout_width="match_parent" android:layout_height="match_parent"
                            android:background="@null" android:hint="Enter full name"
                            android:paddingStart="12dp" android:textColor="@color/text_primary"/>
                    </LinearLayout>

                    <!-- Date of Birth -->
                    <TextView
                        android:text="Date of Birth *"
                        style="@style/MedicalApp"
                        android:layout_marginTop="16dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_rounded_border"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">
                        <ImageView
                            android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_calendar" app:tint="@color/icon_gray"/>
                        <EditText
                            android:id="@+id/etDob"
                            android:layout_width="match_parent" android:layout_height="match_parent"
                            android:background="@null" android:hint="DD.MM.YYYY"
                            android:paddingStart="12dp" android:textColor="@color/text_primary"/>
                    </LinearLayout>

                    <!-- Gender Select -->
                    <TextView
                        android:text="Gender *"
                        style="@style/MedicalApp"
                        android:layout_marginTop="16dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <!-- Кнопка Male -->
                        <TextView
                            android:id="@+id/btnMale"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_gender_active"
                            android:gravity="center"
                            android:text="Male"
                            android:textColor="@color/primary_teal"
                            android:textStyle="bold"/>

                        <!-- Кнопка Female -->
                        <TextView
                            android:id="@+id/btnFemale"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_gender_inactive"
                            android:gravity="center"
                            android:text="Female"
                            android:textColor="@color/text_secondary"
                            android:textStyle="bold"/>
                    </LinearLayout>


                    <!-- Email -->
                    <TextView
                        android:text="Email *"
                        style="@style/MedicalApp"
                        android:layout_marginTop="16dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_rounded_border"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">
                        <ImageView
                            android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_email" app:tint="@color/icon_gray"/>
                        <EditText
                            android:id="@+id/etPatientEmail"
                            android:layout_width="match_parent" android:layout_height="match_parent"
                            android:background="@null" android:hint="patient@email.com"
                            android:inputType="textEmailAddress"
                            android:paddingStart="12dp" android:textColor="@color/text_primary"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Required for patient login"
                        android:textColor="@color/text_hint" android:textSize="12sp"
                        android:layout_marginTop="4dp" android:layout_marginStart="4dp"/>


                    <!-- SNILS -->
                    <TextView
                        android:text="SNILS / ID Number"
                        style="@style/MedicalApp"
                        android:layout_marginTop="16dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_rounded_border"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">
                        <ImageView
                            android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_id_card" app:tint="@color/icon_gray"/>
                        <EditText
                            android:id="@+id/etSnils"
                            android:layout_width="match_parent" android:layout_height="match_parent"
                            android:background="@null" android:hint="Optional"
                            android:paddingStart="12dp" android:textColor="@color/text_primary"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- INFO CARD (Голубая) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_info_card"
                android:orientation="horizontal"
                android:padding="24dp">

                <ImageView
                    android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@drawable/ic_info" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:text="Access Data"
                        android:textColor="@color/info_blue_text"
                        android:textStyle="bold"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView
                        android:text="The system will generate a temporary password for the patient. They will be required to change it on first login."
                        android:textColor="@color/info_blue_text"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Пустое пространство чтобы контент не скрылся за кнопкой -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="20dp" />

        </LinearLayout>
    </ScrollView>

    <!-- НИЖНЯЯ ПАНЕЛЬ С КНОПКОЙ -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="24dp"
        android:elevation="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreatePatient"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Create &amp; Print Access"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/primary_teal"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>