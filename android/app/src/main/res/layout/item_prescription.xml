<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:contentPadding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Верхняя строка: Название + Статус -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Текст (Название + Дозировка) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMedicineName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Амоксициклин 500 мг"
                    android:textColor="@color/text_header"
                    android:textStyle="bold"
                    style="@style/TextAppearance.MedicalApp.Body" />

                <TextView
                    android:id="@+id/tvDosage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 таблетка дважды в день"
                    android:textColor="@color/text_secondary"
                    style="@style/TextAppearance.MedicalApp.Description" />
            </LinearLayout>

            <!-- Status Badge -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_status_active"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="Активно"
                android:textColor="@color/white"
                style="@style/TextAppearance.MedicalApp.Label" />
        </LinearLayout>

        <!-- Дата -->
        <TextView
            android:id="@+id/tvStartDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Начало: 1 фев. 2026 г."
            android:textColor="@color/text_light"
            style="@style/TextAppearance.MedicalApp.Label" />
    </LinearLayout>
</androidx.cardview.widget.CardView>