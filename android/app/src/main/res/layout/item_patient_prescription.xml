<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:contentPadding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Верхняя часть: Иконка + Инфо -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <!-- Круглая иконка таблетки -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_pill_icon" />
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_pill" />
            </FrameLayout>

            <!-- Текстовая информация -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPrescMedicine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Amoxicillin 500mg"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPrescDates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅 Apr 20 – May 10"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvPrescDosage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📝 1 tablet twice daily"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvPrescDoctor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏥 Dr. Petrov A.B."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Прогресс-бар -->
        <FrameLayout
            android:id="@+id/progressContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Полоска прогресса -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="8dp">
                    <!-- Серый фон -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_progress_track" />
                    <!-- Зеленая заливка (ширину менять из кода) -->
                    <View
                        android:id="@+id/progressFill"
                        android:layout_width="120dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_progress_fill" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvPillsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="12 of 30 pills left"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Кнопка Mark as Taken -->
        <TextView
            android:id="@+id/btnMarkTaken"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_teal_rounded"
            android:gravity="center"
            android:text="Mark as Taken"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.cardview.widget.CardView>