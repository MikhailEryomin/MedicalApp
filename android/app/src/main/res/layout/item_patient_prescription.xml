<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/llPrescription"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp"
    android:background="@drawable/bg_medicine_card"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="10dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <FrameLayout
            android:id="@+id/iconContainer"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_pill_icon_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivMedicineIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_pill"
                android:tint="@color/primary_teal"
                android:contentDescription="Лекарство" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/layoutMedicineInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:orientation="vertical"
            app:layout_constraintStart_toEndOf="@id/iconContainer"
            app:layout_constraintEnd_toStartOf="@id/ivArrow"
            app:layout_constraintTop_toTopOf="@id/iconContainer">

            <TextView
                android:id="@+id/tvPrescMedicine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Амоксициллин 500 мг"
                android:textColor="@color/text_header"
                style="@style/TextAppearance.MedicalApp.Body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPrescDates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="📅 20 апр. – 10 мая"
                android:textColor="@color/text_hint"
                style="@style/TextAppearance.MedicalApp.Description"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPrescFrequency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="📝 1 таблетка 2 раза в день"
                android:textColor="@color/text_hint"
                style="@style/TextAppearance.MedicalApp.Label"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDoctor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="🏥 Д-р Петров А.Б."
                android:textColor="@color/text_hint"
                style="@style/TextAppearance.MedicalApp.Label"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivArrow"
            android:layout_width="12dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_chevron_right"
            android:contentDescription="Открыть"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/iconContainer"
            app:layout_constraintBottom_toBottomOf="@id/iconContainer" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Progress -->
    <FrameLayout
        android:id="@+id/progressContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Полоска прогресса -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:progress="50"
                android:max="100" />

        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tvPillsLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="12 из 30 таблеток осталось"
        android:textColor="@color/text_hint"
        android:textSize="12sp"
        android:layout_marginBottom="10dp"
        android:textStyle="bold" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMarkTaken"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"

        android:text="Отметиться"
        android:enabled="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:cornerRadius="16dp"
        app:backgroundTint="@color/primary_teal"
        android:textStyle="bold" />

</LinearLayout>